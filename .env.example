# Copy this file to .env and fill in your values

# LLM + Whisper STT via Groq (required)
GROQ_API_KEY=gsk_...

# LiveKit WebRTC (required for voice)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIm...
LIVEKIT_API_SECRET=...

# TTS — Deepgram required (used for STT too)
DEEPGRAM_API_KEY=...

# Optional: if set, Cartesia replaces Deepgram as primary TTS
CARTESIA_API_KEY=...

# Optional overrides
LIVEKIT_ROOM=rag-voice           # default room name
QDRANT_URL=                      # leave empty for local; set to http://localhost:6333 for Docker
